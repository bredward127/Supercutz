# Copy this file to .env.local and fill in your own values.
# All of these are server-only — never expose any to the browser (no NEXT_PUBLIC_ prefix).

# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Get a key from https://fal.ai/dashboard/keys
FAL_KEY=

# Shared password gating the whole app (see src/proxy.ts) so random visitors
# can't reach it — and burn the two API keys above. Required: if unset, every
# request is denied, including your own. Pick anything; there's no username.
SITE_PASSWORD=
